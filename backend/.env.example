GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CATALOG_PATH=data/products.json
ARTIFACTS_PATH=artifacts
CORS_ORIGINS=["http://localhost:5173"]
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_TOP_K=10
MAX_TOP_K=10
CANDIDATE_BATCH_SIZE=20
MAX_VALIDATION_BATCHES=2
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRY_WAIT_SECONDS=60
LLM_MAX_HTTP_ATTEMPTS=3
SUITABILITY_THRESHOLD=0.70
CACHE_TTL_SECONDS=3600
# SIMILARITY_MINIMUM is unset until evaluation supports a threshold.
